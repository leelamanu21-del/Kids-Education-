# Server port (Render automatically injects PORT at runtime)
PORT=3000

# Runtime environment: development | production
NODE_ENV=production

# Comma-separated list of allowed CORS origins, or * for all origins
ALLOWED_ORIGINS=*

# Display name used inside generated parent progress reports
APP_NAME=PhonicsPath

# Optional API key to protect POST /api/reports/weekly via x-api-key header (leave empty to disable)
REPORT_API_KEY=
